{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verovo.dev/schemas/task-economics.schema.json",
  "title": "Verovo Task Economics Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "period",
    "currency",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "financial_status": {
      "enum": ["complete", "open"]
    },
    "scope": {
      "type": "object",
      "properties": {
        "vendor": {"type": ["string", "null"]},
        "account_ref": {"type": ["string", "null"]},
        "currency": {"type": "string"}
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "properties": {
          "kind": {"type": "string"},
          "detail": {"type": "string"},
          "source": {"type": "string"},
          "record_id": {"type": "string"},
          "status": {"type": "string"},
          "domain": {"type": "string"},
          "resolution": {"type": "string"}
        }
      }
    },
    "allocation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "method": {
            "enum": [
              "equal",
              "headcount",
              "revenue"
            ]
          },
          "basis": {
            "type": "object"
          },
          "driver": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "version": {"type": "string"},
              "source_ref": {"type": "string"}
            }
          },
          "confirmed_by": {"type": "string"},
          "confirmed_at": {"type": "string"},
          "approved_by": {"type": "string"},
          "approved_at": {"type": "string"}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          }
        }
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "usage_id",
          "run_id"
        ],
        "properties": {
          "usage_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "cost": {
            "type": [
              "number",
              "string"
            ]
          },
          "currency": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "financialized": {
            "type": "boolean"
          },
          "charge_id": {
            "type": "string",
            "description": "Explicit shared financial charge identity across usage and invoice rows; importer supplied, never inferred."
          },
          "quantity": {"type": ["number", "string"]},
          "unit": {"type": "string"},
          "rate_rule": {"type": "string"},
          "account_ref": {"type": "string"},
          "vendor": {"type": "string"},
          "financial_status": {"type": "string"},
          "recalculation_status": {"type": "string"},
          "source_party": {"type": "string"},
          "collection_method": {"type": "string"},
          "independence": {"type": "string"},
          "allocatable": {"type": "boolean"},
          "allocation_eligible": {"type": "boolean"}
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "currency": {
            "type": ["string", "null"]
          },
          "total": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "period": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "reviewed": {"type": "boolean"},
          "review_status": {"type": "string"},
          "booking_status": {"type": "string"},
          "extraction_status": {"type": "string"},
          "collection_method": {"type": "string"},
          "independence": {"type": "string"}
        }
      }
    },
    "cost_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cost_id",
          "amount",
          "source_ref"
        ],
        "properties": {
          "cost_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "allocation_rule": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "currency": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "charge_id": {
            "type": "string",
            "description": "Explicit shared financial charge identity across usage and invoice rows; importer supplied, never inferred."
          },
          "quantity": {"type": ["number", "string", "null"]},
          "unit_price": {"type": ["number", "string", "null"]},
          "rate_rule": {"type": ["string", "null"]},
          "account_ref": {"type": "string"},
          "financial_status": {"type": "string"},
          "recalculation_status": {"type": "string"},
          "source_party": {"type": "string"},
          "collection_method": {"type": "string"},
          "independence": {"type": "string"},
          "rule_ref": {"type": "object"},
          "allocatable": {"type": "boolean"},
          "allocation_eligible": {"type": "boolean"}
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "source_ref": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "value_verified": {
            "type": "boolean"
          },
          "currency": {
            "type": "string"
          },
          "outcome_id": {"type": "string"},
          "accepted_by": {"type": "string"},
          "accepted_at": {"type": "string"},
          "value_status": {"type": "string"},
          "source_party": {"type": "string"},
          "source_affiliation": {"type": "string"},
          "control_domain": {"type": "string"},
          "collector_party": {"type": "string"},
          "collection_method": {"type": "string"},
          "confirmation_process": {"type": "string"},
          "independence": {"type": "string"}
        }
      }
    },
    "loss_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "loss_id",
          "amount"
        ],
        "properties": {
          "loss_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
