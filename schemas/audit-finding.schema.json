{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verovo.dev/schemas/audit-finding.schema.json",
  "title": "Verovo Audit Finding",
  "description": "One buyer-side audit finding. A finding that cannot be decided is represented by provable=false, a non-empty reason, and amount.value=null. It must never be coerced to zero. A realized finding additionally requires a settlement_ref, because acceptance is not settlement. Amounts are two-decimal decimal strings (never JSON numbers), matching verovo_healthcheck.task_economics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "case_id",
    "classification",
    "severity",
    "amount",
    "status",
    "evidence_refs",
    "rule_ref",
    "provable"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "duplicate_charge",
        "rate_mismatch",
        "missing_evidence",
        "currency_mismatch",
        "discount_not_applied",
        "refund_missing",
        "shared_cost_allocation",
        "unverified_outcome"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "value", "basis"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "value": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d{2}$",
          "description": "Two-decimal decimal string, e.g. \"44.00\". null only when provable=false. Zero (\"0.00\") is a real measured value, never a stand-in for an unknown amount."
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["identified", "validated", "accepted", "realized", "dismissed"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "affected_lines": {
      "type": "array",
      "description": "Invoice lines whose billing this finding disputes. Coverage counts each line once (its worst open finding), so findings sharing a line cannot double count exposure.",
      "items": {
        "$ref": "#/$defs/affectedLine"
      }
    },
    "rule_ref": {
      "$ref": "#/$defs/ruleRef"
    },
    "provable": {
      "type": "boolean",
      "description": "true only when the finding and its monetary amount are decided from the supplied evidence. false is the UNPROVABLE state: reason is required and amount.value must be null, never zero."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Why the finding cannot be decided. Required when provable=false."
    },
    "settlement_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Credit note, refund reference or other settlement record. Required when status=realized: acceptance alone is not settlement."
    }
  },
  "$defs": {
    "affectedLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_id"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the invoice file, relative to the audit case's evidence root."
        },
        "line_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "record_id"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the audit case's evidence root. Absolute paths and traversal outside the root are rejected."
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "id_field": {
          "type": "string",
          "minLength": 1,
          "description": "Optional field that carries the record id. When absent, the id is matched against scalar values in the record."
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "Optional field the finding relies on (for example amount or task_id). It must exist on the resolved record."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "version", "confirmed_by", "confirmed_at"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_by": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1,
          "description": "ISO 8601 date or date-time at which a human confirmed the rule."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"provable": {"const": false}},
        "required": ["provable"]
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "properties": {
              "value": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"provable": {"const": true}},
        "required": ["provable"]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "value": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "realized"}},
        "required": ["status"]
      },
      "then": {
        "required": ["settlement_ref"],
        "properties": {
          "settlement_ref": {
            "type": "string",
            "minLength": 1
          },
          "provable": {"const": true}
        }
      }
    }
  ]
}
