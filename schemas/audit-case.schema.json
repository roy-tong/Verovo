{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verovo.dev/schemas/audit-case.schema.json",
  "title": "Verovo Audit Case",
  "description": "A period-scoped buyer audit case. Findings are embedded so one file carries the claim, its evidence references and the rule version each finding depends on. The finding definition mirrors audit-finding.schema.json; tests keep the enums and required fields in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "buyer",
    "vendor",
    "period",
    "contract_version",
    "scope",
    "coverage",
    "findings",
    "status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "buyer": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_amount", "unverified_amount", "currency"],
      "properties": {
        "verified_amount": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Reconciled amount in the coverage currency. null means not quantified; never a fabricated zero."
        },
        "unverified_amount": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Open exposure in the coverage currency. null means not quantified; never a fabricated zero."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "status": {
      "type": "string",
      "enum": ["open", "in_review", "closed", "dismissed"]
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "record_id"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the audit case's evidence root. Absolute paths and traversal outside the root are rejected."
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "id_field": {
          "type": "string",
          "minLength": 1,
          "description": "Optional field that carries the record id. When absent, the id is matched against scalar values in the record."
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "Optional field the finding relies on (for example amount or task_id). It must exist on the resolved record."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "version", "confirmed_by", "confirmed_at"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_by": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1,
          "description": "ISO 8601 date or date-time at which a human confirmed the rule."
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "case_id",
        "classification",
        "severity",
        "amount",
        "status",
        "evidence_refs",
        "rule_ref",
        "provable"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "duplicate_charge",
            "rate_mismatch",
            "missing_evidence",
            "currency_mismatch",
            "discount_not_applied",
            "refund_missing",
            "shared_cost_allocation",
            "unverified_outcome"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "value", "basis"],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "value": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "null only when provable=false. Zero is a real measured value, never a stand-in for an unknown amount."
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["identified", "validated", "accepted", "realized", "dismissed"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "rule_ref": {
          "$ref": "#/$defs/ruleRef"
        },
        "provable": {
          "type": "boolean",
          "description": "true only when the finding and its monetary amount are decided from the supplied evidence. false is the UNPROVABLE state: reason is required and amount.value must be null, never zero."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why the finding cannot be decided. Required when provable=false."
        },
        "settlement_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Credit note, refund reference or other settlement record. Required when status=realized: acceptance alone is not settlement."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"provable": {"const": false}},
            "required": ["provable"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "properties": {
                  "value": {"type": "null"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"provable": {"const": true}},
            "required": ["provable"]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "value": {"type": "number"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "realized"}},
            "required": ["status"]
          },
          "then": {
            "required": ["settlement_ref"],
            "properties": {
              "settlement_ref": {
                "type": "string",
                "minLength": 1
              },
              "provable": {"const": true}
            }
          }
        }
      ]
    }
  }
}
