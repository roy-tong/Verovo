{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verovo.dev/schemas/spend-action-list.schema.json",
  "title": "Verovo Spend Action List",
  "description": "A read-only buyer worklist projected from an existing Audit Case. Recommendations do not execute or authorize payment. Clean reviews are bound to invoice bytes and contract versions; settlements are independently verified from credit/payment evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "buyer",
    "vendor",
    "period",
    "actions",
    "summary",
    "executes_payment",
    "buyer_decision_required"
  ],
  "properties": {
    "schema": {"const": "verovo.spend-action-list/0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "buyer": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "minLength": 1},
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"}
      }
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/actionEntry"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "amounts", "case_level_amounts"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "amounts": {
          "type": "array",
          "items": {"$ref": "#/$defs/amountCoverage"}
        },
        "case_level_amounts": {
          "type": "array",
          "items": {"$ref": "#/$defs/amountCoverage"}
        }
      }
    },
    "executes_payment": {"type": "boolean", "const": false},
    "buyer_decision_required": {"type": "boolean", "const": true}
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "evidence_required",
        "review_required",
        "unreviewed",
        "ready_for_payment",
        "partially_settled",
        "settled"
      ]
    },
    "amount": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["currency", "value"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "value": {"type": "string", "pattern": "^-?\\d+\\.\\d{2,3}$"}
      }
    },
    "amountCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "currency", "known_value", "unknown_count"],
      "properties": {
        "action": {"$ref": "#/$defs/action"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "known_value": {
          "type": ["string", "null"],
          "pattern": "^-?\\d+\\.\\d{2,3}$"
        },
        "unknown_count": {"type": "integer", "minimum": 0}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference", "applied_amount", "detail"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "resolution_claimed",
            "credit_issued",
            "partially_settled",
            "settlement_mismatch",
            "settlement_verified"
          ]
        },
        "reference": {"type": ["string", "null"]},
        "applied_amount": {"$ref": "#/$defs/amount"},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "chargeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_source_id",
        "line_id",
        "source_digest",
        "rule_version",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "invoice_source_id": {"type": "string", "minLength": 1},
        "line_id": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the source bytes for binary files, or UTF-8 text normalized to LF line endings for JSON/CSV/text evidence."},
        "rule_version": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1}
      }
    },
    "actionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "source",
        "charge_id",
        "action",
        "owner_role",
        "reason",
        "finding_ids",
        "amount"
      ],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "enum": ["invoice_line", "finding"]},
            "path": {"type": "string"},
            "line_id": {"type": "string"},
            "finding_id": {"type": "string"}
          }
        },
        "charge_id": {"type": ["string", "null"]},
        "action": {"$ref": "#/$defs/action"},
        "owner_role": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "finding_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "amount": {"$ref": "#/$defs/amount"},
        "settlement": {"$ref": "#/$defs/settlement"},
        "charge_review": {"$ref": "#/$defs/chargeReview"}
      }
    }
  }
}
